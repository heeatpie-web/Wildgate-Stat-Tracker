{
  "name": "wildgate-stat-tracker",
  "productName": "Wildgate Stat Tracker",
  "private": true,
  "version": "2.12.4",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Alixerthus",
    "email": "support@wildgate.app"
  },
  "description": "Track your Artifact Brawl and Fleet Battle stats.",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vision": "^5.3.4",
    "canvas-confetti": "^1.9.2",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.7.3",
    "html2canvas": "^1.4.1",
    "jimp": "^1.6.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.2",
    "recharts": "^2.12.2",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-grid-layout": "^1.3.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "tar": "7.5.7",
    "axios": "1.13.5"
  },
  "build": {
    "appId": "com.wildgate.tracker",
    "productName": "Wildgate Stat Tracker",
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.spec.ts",
      "!**/tsconfig.json",
      "!**/README.md"
    ],
    "asarUnpack": [
      "node_modules/screenshot-desktop/**/*"
    ],
    "win": {
      "target": "nsis",
      "forceCodeSigning": false,
      "artifactName": "Wildgate-Stat-Tracker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "heeatpie-web",
        "repo": "Wildgate-Stat-Tracker"
      }
    ]
  }
}
