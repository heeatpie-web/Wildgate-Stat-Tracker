{
  "name": "wildgate-stat-tracker",
  "productName": "Wildgate Stat Tracker",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Alixerthus",
    "email": "support@wildgate.app"
  },
  "description": "Track your Artifact Brawl and Fleet Battle stats.",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "vite build",
    "ci:quality": "npm run lint && npm run test && npm run typecheck && npm run build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"node scripts/run-electron.cjs .\"",
    "electron:dev:newuser": "concurrently \"vite\" \"node scripts/run-electron-newuser.cjs\"",
    "dev:hot": "concurrently \"vite\" \"node scripts/electron-hot-dev.cjs\"",
    "electron:build": "vite build && electron-builder",
    "snap:views": "node scripts/visual-snapshots.mjs",
    "snap:views:real": "node scripts/visual-snapshots.mjs --real-data",
    "snap:phase2:before": "node scripts/phase2-recording-snapshots.mjs --stage=before",
    "snap:phase2:after": "node scripts/phase2-recording-snapshots.mjs --stage=after",
    "snap:baseline": "node scripts/visual-snapshots.mjs --update-baseline",
    "snap:baseline:real": "node scripts/visual-snapshots.mjs --real-data --update-baseline",
    "audit:ui-hardcoded": "node scripts/ui-hardcoded-audit.cjs",
    "audit:editor": "node scripts/start-audit-editor.cjs",
    "ocr:truth:add": "node scripts/ocr_corpus_add_sample.cjs --input dataset/ocr-corpus/ground-truth.input.txt",
    "ocr:truth:list": "node scripts/ocr_corpus_list_samples.cjs --input dataset/ocr-corpus/ground-truth.input.txt",
    "ocr:truth:validate": "node scripts/ocr_corpus_validate_input.cjs --input dataset/ocr-corpus/ground-truth.input.txt",
    "ocr:truth:build": "node scripts/ocr_corpus_from_text.cjs --in dataset/ocr-corpus/ground-truth.input.txt --out dataset/ocr-corpus/ground-truth.json",
    "ocr:predict": "set ELECTRON_ENABLE_LOGGING=0 && electron scripts/ocr_corpus_predict.cjs --truth dataset/ocr-corpus/ground-truth.json --out dataset/ocr-corpus/predictions.latest.json --ocr-mode both",
    "ocr:eval": "node scripts/ocr_corpus_eval.cjs --truth dataset/ocr-corpus/ground-truth.json --pred dataset/ocr-corpus/predictions.latest.json --baseline dataset/ocr-corpus/baseline.json --out dataset/ocr-corpus/reports/latest.json",
    "ocr:eval:exact": "node scripts/ocr_corpus_eval_exact.cjs --truth dataset/ocr-corpus/ground-truth.json --pred dataset/ocr-corpus/predictions.latest.json --baseline dataset/ocr-corpus/baseline.json --out dataset/ocr-corpus/reports/latest.exact.json",
    "eval:exact": "node scripts/ocr_corpus_eval_exact.cjs --truth dataset/ocr-corpus/ground-truth.json --pred dataset/ocr-corpus/predictions.latest.json --baseline dataset/ocr-corpus/baseline.json --out dataset/ocr-corpus/reports/latest.exact.json",
    "ocr:eval:sample": "node scripts/ocr_corpus_eval.cjs --truth dataset/ocr-corpus/ground-truth.sample.json --pred dataset/ocr-corpus/predictions.sample.json --baseline dataset/ocr-corpus/baseline.sample.json --out dataset/ocr-corpus/reports/sample-report.json",
    "ocr:regression:132": "node scripts/ocr_regression_match132.cjs",
    "ocr:baseline:promote": "node scripts/ocr_promote_baseline.cjs --report dataset/ocr-corpus/reports/latest.json --baseline dataset/ocr-corpus/baseline.json",
    "ocr:threshold:recommend": "node scripts/ocr_threshold_recommend.cjs --report dataset/ocr-corpus/reports/latest.json --baseline dataset/ocr-corpus/baseline.json",
    "ocr:ingest:legacy": "electron scripts/ocr_corpus_ingest_legacy.cjs",
    "artifacts:relink:dry": "node scripts/relink_smart_capture_artifacts.cjs --dry-run",
    "artifacts:relink": "node scripts/relink_smart_capture_artifacts.cjs --apply",
    "artifacts:migrate:canonical": "node scripts/migrate_artifact_folders_to_canonical.cjs",
    "artifacts:migrate:canonical:force": "node scripts/migrate_artifact_folders_to_canonical.cjs --force",
    "dev:qa": "npm run snap:views && npm run ci:quality",
    "setup:parallel-streams": "powershell -ExecutionPolicy Bypass -File scripts/setup-parallel-streams.ps1 -IncludeContract",
    "check:stream-ownership": "node scripts/check-stream-ownership.cjs --stream auto",
    "check:stream-ownership:ui": "node scripts/check-stream-ownership.cjs --stream ui",
    "check:stream-ownership:ocr": "node scripts/check-stream-ownership.cjs --stream ocr",
    "check:stream-ownership:contract": "node scripts/check-stream-ownership.cjs --stream contract",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.7.3",
    "onnxruntime-node": "^1.24.2",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-grid-layout": "^1.3.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "canvas-confetti": "^1.9.2",
    "concurrently": "^8.2.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "html2canvas": "^1.4.1",
    "jimp": "^1.6.0",
    "jsdom": "^28.0.0",
    "lucide-react": "^0.344.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.2",
    "recharts": "^2.12.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.2"
  },
  "overrides": {
    "tar": "7.5.7",
    "axios": "1.13.5"
  },
  "build": {
    "appId": "com.wildgate.tracker",
    "productName": "Wildgate Stat Tracker",
    "icon": "electron/assets/icon.ico",
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "uid-seed.json",
      "scripts/ocr*.cjs",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.spec.ts",
      "!**/tsconfig.json",
      "!**/README.md"
    ],
    "asarUnpack": [
      "node_modules/screenshot-desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "models/paddleocr",
        "to": "models/paddleocr"
      },
      {
        "from": "electron/assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "electron/assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": "nsis",
      "forceCodeSigning": false,
      "artifactName": "Wildgate-Stat-Tracker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "heeatpie-web",
        "repo": "Wildgate-Stat-Tracker"
      }
    ]
  }
}
